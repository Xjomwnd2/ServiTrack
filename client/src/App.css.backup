* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
}

button {
  cursor: pointer;
}

.app {
  min-height: 100vh;
  background: #f5f7fb;
}

.navbar {
  height: 70px;
  display: flex;
  align-items: center;
  padding: 0 50px;
  background: white;
  border-bottom: 1px solid #e5e7eb;
}

.logo {
  font-size: 26px;
  font-weight: 700;
}

.hero {
  min-height: calc(100vh - 70px);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60px;
  padding: 60px 30px;
}

.hero-content {
  max-width: 600px;
}

.hero-content h1 {
  margin: 0 0 20px;
  font-size: 52px;
  line-height: 1.1;
}

.hero-content p {
  font-size: 19px;
  line-height: 1.6;
}

.login-card {
  width: 360px;
  padding: 30px;
  background: white;
  border-radius: 14px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
}

.login-card form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.login-card input {
  padding: 12px;
  border: 1px solid #d1d5db;
  border-radius: 7px;
  margin-bottom: 10px;
}

.primary-button,
.logout-button {
  border: none;
  border-radius: 8px;
  padding: 12px 22px;
  font-weight: 600;
}

.primary-button {
  background: #2563eb;
  color: white;
}

.message {
  margin-top: 15px;
}

.dashboard {
  min-height: 100vh;
  background: #f5f7fb;
}

.dashboard-header {
  height: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30px;
  background: white;
  border-bottom: 1px solid #e5e7eb;
}

.user-area {
  display: flex;
  align-items: center;
  gap: 20px;
}

.logout-button {
  background: #111827;
  color: white;
}

.dashboard-layout {
  display: flex;
  min-height: calc(100vh - 70px);
}

.sidebar {
  width: 230px;
  padding: 25px 15px;
  background: #111827;
}

.sidebar h3 {
  color: white;
  padding-left: 10px;
}

.sidebar button {
  width: 100%;
  display: block;
  padding: 13px 10px;
  margin: 5px 0;
  text-align: left;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: white;
}

.sidebar button:hover {
  background: #374151;
}

.dashboard-content {
  flex: 1;
  padding: 40px;
}

.dashboard-content h1 {
  margin-top: 0;
  font-size: 36px;
}

.welcome {
  color: #6b7280;
  font-size: 17px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-top: 30px;
}

.stat-card {
  padding: 25px;
  background: white;
  border-radius: 12px;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
}

.stat-card h3 {
  margin-top: 0;
  color: #6b7280;
  font-size: 15px;
}

.stat-card strong {
  font-size: 32px;
}

.dashboard-section {
  margin-top: 30px;
  padding: 25px;
  background: white;
  border-radius: 12px;
}

@media (max-width: 900px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .dashboard-layout {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
  }

  .hero {
    flex-direction: column;
  }

  .hero-content h1 {
    font-size: 38px;
  }
}
