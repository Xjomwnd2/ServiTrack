/* =========================================================
   SERVITRACK - APPLICATION STYLES
   ========================================================= */

* {
  box-sizing: border-box;
}

:root {
  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --secondary: #0f766e;
  --navy: #0f172a;
  --navy-light: #1e293b;
  --background: #f1f5f9;
  --card: #ffffff;
  --border: #e2e8f0;
  --text: #0f172a;
  --muted: #64748b;
  --success: #15803d;
  --warning: #b45309;
  --danger: #dc2626;
  --shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
  --shadow-small: 0 4px 14px rgba(15, 23, 42, 0.06);
}

body {
  margin: 0;
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  color: var(--text);
  background: var(--background);
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

input,
textarea,
select {
  outline: none;
}

/* =========================================================
   LOGIN PAGE
   ========================================================= */

.app {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(37, 99, 235, 0.14), transparent 35%),
    radial-gradient(circle at bottom right, rgba(15, 118, 110, 0.12), transparent 35%),
    var(--background);
}

.navbar {
  height: 72px;
  display: flex;
  align-items: center;
  padding: 0 6%;
  background: rgba(255, 255, 255, 0.92);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
}

.logo {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: -0.6px;
  color: var(--primary);
}

.hero {
  min-height: calc(100vh - 72px);
  display: grid;
  grid-template-columns: minmax(0, 1fr) 390px;
  align-items: center;
  gap: 80px;
  max-width: 1200px;
  margin: auto;
  padding: 60px 30px;
}

.hero-content {
  max-width: 650px;
}

.hero-content h1 {
  margin: 0 0 22px;
  font-size: clamp(40px, 5vw, 64px);
  line-height: 1.05;
  letter-spacing: -2px;
}

.hero-content p {
  max-width: 580px;
  margin: 0;
  color: var(--muted);
  font-size: 19px;
  line-height: 1.7;
}

.login-card {
  width: 100%;
  padding: 34px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: var(--shadow);
}

.login-card h2 {
  margin-top: 0;
  margin-bottom: 24px;
  font-size: 27px;
}

.login-card form {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.login-card label,
.customer-form-card label {
  margin-top: 8px;
  font-size: 14px;
  font-weight: 700;
  color: #334155;
}

.login-card input {
  width: 100%;
  padding: 13px 14px;
  margin-bottom: 7px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #f8fafc;
}

.login-card input:focus,
.customer-form-card input:focus,
.customer-form-card textarea:focus,
.customer-form-card select:focus,
.customer-list-header input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  background: white;
}

.message {
  margin-top: 15px;
  color: var(--danger);
  font-size: 14px;
}

/* =========================================================
   BUTTONS
   ========================================================= */

.primary-button,
.logout-button,
.cancel-button,
.edit-button,
.delete-button {
  border: none;
  border-radius: 9px;
  padding: 11px 17px;
  font-weight: 700;
  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease,
    background 0.15s ease;
}

.primary-button {
  background: var(--primary);
  color: white;
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2);
}

.primary-button:hover {
  background: var(--primary-dark);
  transform: translateY(-1px);
}

.logout-button {
  background: #f1f5f9;
  color: #334155;
}

.logout-button:hover {
  background: #e2e8f0;
}

.cancel-button {
  background: #e2e8f0;
  color: #334155;
}

.edit-button {
  background: #dbeafe;
  color: #1d4ed8;
}

.delete-button {
  background: #fee2e2;
  color: #b91c1c;
}

.edit-button:hover,
.delete-button:hover,
.cancel-button:hover {
  transform: translateY(-1px);
}

/* =========================================================
   MAIN DASHBOARD
   ========================================================= */

.dashboard {
  min-height: 100vh;
  background: var(--background);
}

.dashboard-header {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  background: white;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 20;
}

.dashboard-header .logo {
  font-size: 24px;
}

.user-area {
  display: flex;
  align-items: center;
  gap: 15px;
}

.user-area span {
  color: #475569;
  font-size: 14px;
  font-weight: 600;
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.dashboard-layout {
  display: flex;
  min-height: calc(100vh - 72px);
}

.sidebar {
  width: 245px;
  flex-shrink: 0;
  padding: 28px 16px;
  background: linear-gradient(180deg, var(--navy), #172033);
  color: white;
}

.sidebar h3 {
  margin: 0 10px 20px;
  color: #94a3b8;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.sidebar button {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 13px 14px;
  margin: 5px 0;
  text-align: left;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: #cbd5e1;
  font-weight: 600;
  transition: 0.2s ease;
}

.sidebar button:hover {
  background: rgba(255, 255, 255, 0.08);
  color: white;
}

.sidebar button.active-menu {
  background: rgba(37, 99, 235, 0.95);
  color: white;
  box-shadow: 0 5px 15px rgba(37, 99, 235, 0.25);
}

/* =========================================================
   CONTENT
   ========================================================= */

.dashboard-content {
  flex: 1;
  min-width: 0;
  padding: 36px;
  overflow-x: hidden;
}

.dashboard-content h1 {
  margin: 0;
  font-size: 32px;
  line-height: 1.2;
  letter-spacing: -0.8px;
}

.welcome {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 15px;
}

/* =========================================================
   PAGE HEADINGS
   ========================================================= */

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
}

.page-heading h1 {
  margin: 0;
}

/* =========================================================
   DASHBOARD STAT CARDS
   ========================================================= */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-top: 28px;
}

.stat-card {
  position: relative;
  overflow: hidden;
  padding: 23px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow: var(--shadow-small);
}

.stat-card::after {
  content: "";
  position: absolute;
  width: 65px;
  height: 65px;
  right: -20px;
  top: -20px;
  border-radius: 50%;
  background: rgba(37, 99, 235, 0.08);
}

.stat-card h3 {
  margin: 0 0 12px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
}

.stat-card strong {
  font-size: 34px;
  letter-spacing: -1px;
}

/* =========================================================
   SECTIONS / CARDS
   ========================================================= */

.dashboard-section,
.customer-list-card,
.customer-form-card {
  margin-top: 24px;
  padding: 25px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow: var(--shadow-small);
}

.dashboard-section h2,
.customer-list-card h2,
.customer-form-card h2 {
  margin-top: 0;
  margin-bottom: 20px;
  font-size: 20px;
}

/* =========================================================
   FORMS
   ========================================================= */

.customer-form-card form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px 18px;
}

.customer-form-card form label {
  align-self: end;
}

.customer-form-card input,
.customer-form-card textarea,
.customer-form-card select {
  width: 100%;
  padding: 12px 13px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: #f8fafc;
  color: var(--text);
}

.customer-form-card textarea {
  resize: vertical;
  min-height: 95px;
}

.customer-form-card form > textarea,
.customer-form-card form > button,
.customer-form-card form > .form-actions {
  grid-column: 1 / -1;
}

.customer-form-card form > button {
  justify-self: start;
  margin-top: 10px;
}

.form-actions {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

/* =========================================================
   LIST HEADER / SEARCH
   ========================================================= */

.customer-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.customer-list-header h2 {
  margin: 0;
}

.customer-list-header input {
  width: 280px;
  padding: 11px 13px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: #f8fafc;
}

/* =========================================================
   TABLES
   ========================================================= */

.customer-table-wrapper {
  width: 100%;
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 12px;
}

.customer-table {
  width: 100%;
  min-width: 760px;
  border-collapse: collapse;
}

.customer-table th {
  padding: 13px 15px;
  background: #f8fafc;
  color: #475569;
  font-size: 12px;
  font-weight: 800;
  text-align: left;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  border-bottom: 1px solid var(--border);
}

.customer-table td {
  padding: 14px 15px;
  border-bottom: 1px solid #eef2f7;
  color: #334155;
  font-size: 14px;
  vertical-align: middle;
}

.customer-table tbody tr:hover {
  background: #f8fafc;
}

.customer-table tbody tr:last-child td {
  border-bottom: none;
}

.action-buttons {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
}

/* =========================================================
   STATUS SELECTS
   ========================================================= */

.customer-table select {
  padding: 7px 9px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: white;
}

/* =========================================================
   RESPONSIVE - TABLET
   ========================================================= */

@media (max-width: 1100px) {
  .hero {
    grid-template-columns: 1fr 350px;
    gap: 40px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .sidebar {
    width: 215px;
  }

  .dashboard-content {
    padding: 28px;
  }
}

/* =========================================================
   RESPONSIVE - MOBILE
   ========================================================= */

@media (max-width: 800px) {
  .dashboard-header {
    padding: 0 18px;
  }

  .user-area span {
    display: none;
  }

  .dashboard-layout {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    padding: 10px;
    display: flex;
    gap: 6px;
    overflow-x: auto;
  }

  .sidebar h3 {
    display: none;
  }

  .sidebar button {
    min-width: max-content;
    width: auto;
    margin: 0;
    padding: 10px 14px;
  }

  .dashboard-content {
    padding: 22px 16px;
  }

  .dashboard-content h1 {
    font-size: 27px;
  }

  .page-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .page-heading .primary-button {
    width: 100%;
  }

  .customer-form-card,
  .customer-list-card,
  .dashboard-section {
    padding: 18px;
  }

  .customer-form-card form {
    grid-template-columns: 1fr;
  }

  .customer-form-card form > textarea,
  .customer-form-card form > button,
  .customer-form-card form > .form-actions {
    grid-column: auto;
  }

  .customer-list-header {
    align-items: stretch;
    flex-direction: column;
  }

  .customer-list-header input {
    width: 100%;
  }
}

/* =========================================================
   RESPONSIVE - SMALL PHONE
   ========================================================= */

@media (max-width: 600px) {
  .navbar {
    padding: 0 20px;
  }

  .hero {
    min-height: auto;
    grid-template-columns: 1fr;
    gap: 30px;
    padding: 45px 20px;
  }

  .hero-content h1 {
    font-size: 40px;
  }

  .hero-content p {
    font-size: 16px;
  }

  .login-card {
    padding: 24px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-header {
    height: 64px;
  }

  .dashboard-header .logo {
    font-size: 21px;
  }

  .sidebar {
    scrollbar-width: thin;
  }

  .sidebar button {
    font-size: 13px;
  }

  .primary-button {
    width: 100%;
  }

  .form-actions {
    flex-direction: column;
  }

  .form-actions button {
    width: 100%;
  }
}
